{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konfigurasi Peta Kawasan SCBD & PIK",
  "description": "Dibaca saat aplikasi dimulai (public/config.json, ikut tersalin ke dist/). Semua bagian opsional: yang tidak diisi memakai nilai bawaan. Nilai yang salah diabaikan dan dilaporkan di console browser.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "lonLat": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "[longitude, latitude] WGS84" },
    "buildingSource": {
      "description": "Sumber bangunan 3D.",
      "oneOf": [
        { "type": "object", "properties": { "type": { "const": "basemap" } }, "required": ["type"], "description": "Pakai bangunan dari basemap 3D aktif." },
        {
          "type": "object",
          "properties": { "type": { "const": "portal-item" }, "id": { "type": "string", "description": "ID item ArcGIS (layer → layer bangunan; Web Scene/Web Map → basemap)." }, "portalUrl": { "type": "string" } },
          "required": ["type", "id"]
        },
        { "type": "object", "properties": { "type": { "const": "scene-service" }, "url": { "type": "string", "description": "URL SceneServer." } }, "required": ["type", "url"] },
        {
          "type": "object",
          "properties": {
            "type": { "const": "geojson" },
            "url": { "type": "string" },
            "heightField": { "type": "string", "description": "Nama field tinggi (meter)." },
            "defaultHeight": { "type": "number" }
          },
          "required": ["type", "url", "heightField"]
        }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },

    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "Judul di header dan tab browser." },
        "subtitle": { "type": "string", "description": "Teks kecil di bawah judul." },
        "theme": { "enum": ["auto", "dark", "light"], "description": "Tema awal. auto = mengikuti pengaturan sistem." },
        "viewMode": { "enum": ["3d", "2d"], "description": "Mode tampilan awal." }
      }
    },

    "camera": {
      "type": "object",
      "description": "Kamera 3D saat aplikasi dibuka.",
      "required": ["longitude", "latitude", "z", "heading", "tilt"],
      "additionalProperties": false,
      "properties": {
        "longitude": { "type": "number" },
        "latitude": { "type": "number" },
        "z": { "type": "number", "description": "Ketinggian kamera (meter)." },
        "heading": { "type": "number", "description": "Arah hadap (derajat, 0 = utara)." },
        "tilt": { "type": "number", "description": "Kemiringan (0 = tegak lurus ke bawah, 90 = horizontal)." }
      }
    },

    "kawasan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webmapId": { "type": "string", "description": "ID item web map kawasan (ArcGIS Online)." },
        "portalUrl": { "type": "string", "description": "URL portal/organisasi ArcGIS tempat web map berada." },
        "oauthClientId": { "type": "string", "description": "Client ID OAuth (opsional; bila kosong memakai ARCGIS_CLIENT_ID di .env). Redirect URI: <url aplikasi>/oauth-callback.html." },
        "fallbackBasemap2d": { "type": "string", "description": "Basemap 2D bila web map belum bisa dimuat." },
        "layerOffset3d": { "type": "number", "description": "Tinggi (meter) layer web map di atas tanah pada mode 3D." },
        "webmapLayers": {
          "type": "object",
          "description": "Tampil/sembunyikan layer web map berdasarkan judul layer, mis. { \"SCBDPIK\": true }. Layer yang tidak disebut mengikuti pengaturan web map.",
          "additionalProperties": { "type": "boolean" }
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "description": "Kawasan: menjadi tombol di header, bookmark bawaan, dan bookmark web map untuk Asisten AI. Kawasan pertama = tampilan awal 2D.",
          "items": {
            "type": "object",
            "required": ["id", "name", "center", "extent", "camera"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "center": { "$ref": "#/definitions/lonLat" },
              "extent": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[xmin, ymin, xmax, ymax] WGS84, dipakai di 2D." },
              "camera": {
                "type": "object",
                "required": ["offsetLat", "z", "tilt", "heading"],
                "additionalProperties": false,
                "description": "Kamera 3D: posisi kamera = pusat kawasan digeser offsetLat derajat ke selatan.",
                "properties": {
                  "offsetLat": { "type": "number" },
                  "z": { "type": "number" },
                  "tilt": { "type": "number" },
                  "heading": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },

    "layers": {
      "type": "object",
      "description": "Layer yang aktif saat aplikasi dibuka (true/false). Bisa diubah lagi di panel Layer & legenda.",
      "additionalProperties": false,
      "properties": {
        "buildings": { "type": "boolean", "description": "Bangunan 3D" },
        "surface": { "type": "boolean", "description": "Indeks permukaan polusi (volume interpolasi)" },
        "stations": { "type": "boolean", "description": "Kolom stasiun pemantau 3D" },
        "wind-flow": { "type": "boolean", "description": "Simulasi angin 3D (partikel & streamline). Berat: aktifkan bila perlu." },
        "wind": { "type": "boolean", "description": "Panah angin statis" },
        "trees": { "type": "boolean", "description": "Pohon (simulasi penanaman)" },
        "model-import": { "type": "boolean", "description": "Model 3D dari menu Tambah data" },
        "space-time-cube": { "type": "boolean", "description": "Space-time cube" },
        "emissions": { "type": "boolean", "description": "Emisi CO₂e per kota" },
        "atmosphere": { "type": "boolean", "description": "Atmosfer (hujan/awan, kabut dari PM2.5)" },
        "daylight": { "type": "boolean", "description": "Pencahayaan mengikuti jam timeline" }
      }
    },

    "widgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "array",
          "description": "Panel yang ditampilkan, berurutan sesuai daftar bawaan. Hapus id untuk menyembunyikan panel.",
          "items": { "enum": ["bookmarks", "assistant", "add-data", "chart", "weather", "wind", "trees", "trend", "emissions", "layers", "about", "summary"] },
          "uniqueItems": true
        },
        "open": {
          "description": "Panel kiri yang terbuka saat aplikasi dibuka. \"\" = tidak ada.",
          "enum": ["", "bookmarks", "assistant", "add-data", "chart", "weather", "wind", "trees", "trend", "emissions", "layers", "about"]
        },
        "timelineDock": { "type": "boolean", "description": "Tampilkan dock timeline di bawah saat dibuka (tetap bisa dibuka dengan tombol Timeline)." }
      }
    },

    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["historical", "realtime", "forecast"], "description": "Mode waktu awal." },
        "indicator": { "enum": ["pm2_5", "pm10", "no2", "o3", "so2", "co", "ispu"], "description": "Indikator kualitas udara awal." },
        "speed": { "enum": [1, 2, 4, 8, 16], "description": "Kecepatan timelapse (jam per detik)." },
        "realtimeRefreshMinutes": { "type": "number", "description": "Interval refresh mode real-time (menit)." },
        "maxHistoricalDays": { "type": "number", "description": "Panjang maksimum rentang historis (hari)." }
      }
    },

    "basemaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dark": { "type": "string", "description": "Basemap 3D untuk tema gelap." },
        "light": { "type": "string", "description": "Basemap 3D untuk tema terang." },
        "fallbackDark": { "type": "string", "description": "Cadangan bila basemap 3D gagal (tema gelap)." },
        "fallbackLight": { "type": "string", "description": "Cadangan bila basemap 3D gagal (tema terang)." },
        "options": {
          "type": "array",
          "description": "Pilihan di panel Layer & legenda. id = id basemap ArcGIS atau \"item:<id item>\".",
          "items": { "type": "object", "required": ["id", "label"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "label": { "type": "string" } } }
        }
      }
    },

    "buildings": { "$ref": "#/definitions/buildingSource" },
    "buildingsFallback": { "$ref": "#/definitions/buildingSource" },

    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "description": { "type": "string" },
        "entryMessage": { "type": "string", "description": "Pesan pembuka sebelum ada percakapan." },
        "suggestedPrompts": { "type": "array", "items": { "type": "string" }, "description": "Contoh pertanyaan (2–3 disarankan)." }
      }
    },

    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useMockData": { "type": "boolean", "description": "true = selalu pakai data sintetis (demo offline)." },
        "bmkgBaseUrl": { "type": "string", "description": "Base URL API BMKG / proxy Anda." }
      }
    },

    "stations": {
      "type": "array",
      "minItems": 1,
      "description": "Titik pemantau kualitas udara.",
      "items": {
        "type": "object",
        "required": ["id", "name", "shortName", "kind", "latitude", "longitude"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "shortName": { "type": "string", "description": "Label di peta 3D." },
          "kind": { "enum": ["spku", "embassy", "model"], "description": "spku = stasiun DLH, embassy = US Embassy, model = titik sampel model." },
          "district": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" }
        }
      }
    },

    "weatherLocations": {
      "type": "array",
      "minItems": 1,
      "description": "Titik cuaca (prakiraan BMKG per kelurahan).",
      "items": {
        "type": "object",
        "required": ["id", "name", "latitude", "longitude"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "adm4": { "type": "string", "description": "Kode wilayah BMKG tingkat IV (kelurahan)." },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" }
        }
      }
    }
  }
}
