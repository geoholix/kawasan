{
  "$schema": "./config.schema.json",

  "app": {
    "title": "Peta Kawasan SCBD & PIK",
    "subtitle": "Digital twin kawasan & kualitas udara Jakarta",
    "theme": "auto",
    "viewMode": "3d"
  },

  "camera": { "longitude": 106.8115, "latitude": -6.234, "z": 650, "heading": 0, "tilt": 62 },

  "kawasan": {
    "webmapId": "e8ff91a9c03d46bd995646e06438faaf",
    "portalUrl": "https://tiger.maps.arcgis.com",
    "fallbackBasemap2d": "topo-vector",
    "layerOffset3d": 2,
    "webmapLayers": { "SCBDPIK": true },
    "areas": [
      {
        "id": "scbd",
        "name": "SCBD",
        "description": "Sudirman Central Business District, Jakarta Selatan",
        "center": [106.8115, -6.2265],
        "extent": [106.8025, -6.2365, 106.8205, -6.2165],
        "camera": { "offsetLat": 0.0075, "z": 650, "tilt": 62, "heading": 0 }
      },
      {
        "id": "pik",
        "name": "PIK",
        "description": "Pantai Indah Kapuk, Jakarta Utara",
        "center": [106.742, -6.109],
        "extent": [106.715, -6.1255, 106.77, -6.0925],
        "camera": { "offsetLat": 0.014, "z": 1600, "tilt": 60, "heading": 0 }
      }
    ]
  },

  "layers": {
    "buildings": true,
    "surface": true,
    "stations": true,
    "wind-flow": false,
    "wind": false,
    "trees": false,
    "model-import": true,
    "space-time-cube": false,
    "emissions": false,
    "atmosphere": false,
    "daylight": false
  },

  "widgets": {
    "enabled": ["bookmarks", "assistant", "add-data", "chart", "weather", "wind", "trees", "trend", "emissions", "layers", "about", "summary"],
    "open": "bookmarks",
    "timelineDock": true
  },

  "time": {
    "mode": "historical",
    "indicator": "pm2_5",
    "speed": 4,
    "realtimeRefreshMinutes": 15,
    "maxHistoricalDays": 31
  },

  "basemaps": {
    "dark": "dark-gray-3d",
    "light": "gray-3d",
    "fallbackDark": "dark-gray-vector",
    "fallbackLight": "gray-vector",
    "options": [
      { "id": "dark-gray-3d", "label": "Dark Gray 3D" },
      { "id": "gray-3d", "label": "Light Gray 3D" },
      { "id": "navigation-dark-3d", "label": "Navigasi gelap 3D" },
      { "id": "navigation-3d", "label": "Navigasi 3D" },
      { "id": "streets-3d", "label": "Streets 3D" },
      { "id": "topo-3d", "label": "Topografi 3D" },
      { "id": "osm-3d", "label": "OpenStreetMap 3D" },
      { "id": "satellite", "label": "Citra satelit (2D + bangunan OSM)" },
      { "id": "dark-gray-vector", "label": "Dark Gray 2D (+ bangunan OSM)" }
    ]
  },

  "buildings": { "type": "portal-item", "id": "c444b24b184c4523a5dc96248bfea4e1" },
  "buildingsFallback": { "type": "portal-item", "id": "ca0470dbbddb4db28bad74ed39949e25" },

  "assistant": {
    "heading": "Asisten Kawasan",
